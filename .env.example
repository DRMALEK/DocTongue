BACKEND_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=

APP_NAME=DocTongue API
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_ROOT=./backend/data
UPLOADS_DIR=./backend/data/uploads
CHROMA_DIR=./backend/data/chroma
DOCUMENTS_MANIFEST=./backend/data/documents.json
CHROMA_COLLECTION_NAME=documents
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
MAX_ANSWER_CITATIONS=3
QUALITY_CONTROL_ENABLED=1
QUALITY_CONTROL_THRESHOLD=0.5
QUALITY_CONTROL_FAIL_OPEN=1
QUALITY_CONTROL_INCLUDE_REASON=1
CHAT_MEMORY_WINDOW=3
CHAT_MEMORY_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_KEY_PREFIX=doctongue:chat
RUN_LIVE_LLM_SMOKE_TEST=0

# Optional provider secrets used by LiteLLM-compatible models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=